root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,md,toml,json,txt}]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf

# Preserve saved measurements and generated reports as recorded.
[**/results/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
